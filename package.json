{
  "name": "agent-context-lint",
  "version": "0.1.1",
  "description": "Lint AI coding agent context files (AGENTS.md, CLAUDE.md, .cursorrules, copilot-instructions.md) for staleness, broken paths, and semantic quality issues.",
  "keywords": [
    "agents-md",
    "claude-md",
    "cursorrules",
    "copilot-instructions",
    "ai-agent",
    "lint",
    "context-file",
    "cli",
    "developer-tools",
    "code-quality"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mattschaller/agent-context-lint"
  },
  "author": "Matthew Schaller <matt@mattschaller.com>",
  "type": "module",
  "bin": {
    "agent-context-lint": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "action.yml"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run test"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
